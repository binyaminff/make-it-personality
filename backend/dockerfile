# שלב 1: בנייה (Build)
FROM node:20-alpine AS builder

WORKDIR /app

# העתקת קבצי הגדרות התלויות
COPY package*.json ./
COPY tsconfig.json ./

# התקנת כל התלויות (כולל devDependencies לצורך הידור)
RUN npm install

# העתקת שאר הקוד והידור
COPY . .
RUN npm run build

# שלב 2: הרצה (Production)
FROM node:20-alpine

WORKDIR /app

# העתקת רק מה שצריך להרצה
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package*.json ./

# התקנת תלויות פרודקשן בלבד (חוסך המון מקום)
RUN npm install --only=production

EXPOSE 3000

# הרצת השרת מתוך תיקיית ה-dist
CMD ["node", "dist/server.js"]